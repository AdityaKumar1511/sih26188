# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard > Environment)
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase API Key (anon public key or service_role key)
SUPABASE_KEY=eyJh...
SUPABASE_ANON_KEY=eyJh...

# Port (Render sets this automatically)
PORT=8000

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard > Environment Variables)
# ==============================================================================

# Live Render backend URL (e.g. https://sih26188-naq6.onrender.com)
NEXT_PUBLIC_API_URL=https://sih26188-naq6.onrender.com
